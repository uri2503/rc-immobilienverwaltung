NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig, für die Betriebspass-Sync-Brücke (Objekt-Detailseite,
# Button "Nach Betriebspass übertragen"). Niemals mit NEXT_PUBLIC_ prefixen —
# umgeht RLS. Zu finden in Supabase unter Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# User-ID (auth.users.id) des Betriebspass-Accounts, in den synchronisiert wird.
BETRIEBSPASS_SYNC_USER_ID=
